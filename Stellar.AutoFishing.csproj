<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildThisFileDirectory)Local.props" Condition="Exists('$(MSBuildThisFileDirectory)Local.props')" />

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS8632;CS8765</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Stellar.AutoFishing</RootNamespace>
    <AssemblyName>Stellar.AutoFishing</AssemblyName>
    <Version>2.3.0</Version>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icon "A1" (fish + line + hook) is pre-drawn per size (house rule: never one master scaled down); the code picks the
         exact bitmap (Plugin.Style.Blocks.cs PluginIconPng). The SVG sources under resources/icons/src are kept for
         redraws and are NOT embedded. -->
    <EmbeddedResource Include="resources/icons/autofishing-*.png" LogicalName="Stellar.AutoFishing.%(Filename).png" />
    <EmbeddedResource Include="Lang/en.json" LogicalName="Stellar.AutoFishing.Lang.en.json" />
    <EmbeddedResource Include="Lang/ja.json" LogicalName="Stellar.AutoFishing.Lang.ja.json" />
    <EmbeddedResource Include="Lang/th.json" LogicalName="Stellar.AutoFishing.Lang.th.json" />
    <EmbeddedResource Include="Lang/id.json" LogicalName="Stellar.AutoFishing.Lang.id.json" />
    <EmbeddedResource Include="Lang/fil.json" LogicalName="Stellar.AutoFishing.Lang.fil.json" />
    <EmbeddedResource Include="Lang/ko.json" LogicalName="Stellar.AutoFishing.Lang.ko.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Localization (fw 2.1.0+) and the house-style UI kit theme status colours (fw 2.30.0). -->
    <PackageReference Include="Stellar.Abstractions"       Version="2.30.0" />
    <PackageReference Include="Stellar.PluginContracts"    Version="2.30.0" />
    <PackageReference Include="Stellar.Plugin.InteropRefs" Version="2.30.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="resources/**" />
  </ItemGroup>

</Project>
