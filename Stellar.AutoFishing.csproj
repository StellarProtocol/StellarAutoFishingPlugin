<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildThisFileDirectory)Local.props" Condition="Exists('$(MSBuildThisFileDirectory)Local.props')" />

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS8632;CS8765</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Stellar.AutoFishing</RootNamespace>
    <AssemblyName>Stellar.AutoFishing</AssemblyName>
    <Version>1.0.0</Version>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="resources/fishing-icon.png" LogicalName="Stellar.AutoFishing.fishing-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Stellar.Abstractions"       Version="1.1.1" />
    <PackageReference Include="Stellar.PluginContracts"    Version="1.1.1" />
    <PackageReference Include="Stellar.Plugin.InteropRefs" Version="1.1.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="resources/**" />
  </ItemGroup>

  <!-- Post-build: copy DLL to local plugins/ and (if GameInstallDir is set) to game dir -->
  <PropertyGroup>
    <PluginDeployDir>$(MSBuildThisFileDirectory)plugins\autofishing\</PluginDeployDir>
    <GamePluginDir Condition="'$(GameInstallDir)' != ''">$(GameInstallDir)\stellar\plugins\autofishing\</GamePluginDir>
  </PropertyGroup>

  <Target Name="DeployPlugin" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(PluginDeployDir)" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(GamePluginDir)"
          Condition="'$(GamePluginDir)' != ''" />
    <Warning Text="Local.props not found — skipping game deploy. Copy Local.props.example to Local.props and set GameInstallDir."
             Condition="'$(GamePluginDir)' == ''" />
  </Target>
</Project>
